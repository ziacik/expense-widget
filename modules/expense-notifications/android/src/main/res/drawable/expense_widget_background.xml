<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
	<item>
		<shape android:shape="rectangle">
			<gradient
				android:angle="0"
				android:endColor="@color/expense_widget_background_end"
				android:startColor="@color/expense_widget_background" />
			<stroke
				android:width="1dp"
				android:color="@color/expense_widget_border" />
			<corners android:radius="8dp" />
		</shape>
	</item>

	<item
		android:gravity="top|fill_horizontal"
		android:left="8dp"
		android:right="8dp">
		<shape android:shape="rectangle">
			<solid android:color="@color/expense_widget_highlight" />
			<size android:height="1dp" />
			<corners android:radius="1dp" />
		</shape>
	</item>
</layer-list>
