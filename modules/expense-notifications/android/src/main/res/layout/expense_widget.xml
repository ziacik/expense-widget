<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@android:id/background"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@drawable/expense_widget_background"
	android:contentDescription="@string/expense_widget_description"
	android:padding="7dp">

	<ImageView
		android:id="@+id/expense_widget_artwork"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:importantForAccessibility="no"
		android:scaleType="fitCenter"
		android:visibility="gone" />

	<LinearLayout
		android:id="@+id/expense_widget_amount_group"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:baselineAligned="true"
		android:baselineAlignedChildIndex="0"
		android:gravity="center"
		android:orientation="horizontal">

		<TextView
			android:id="@+id/expense_widget_whole"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:fontFamily="@font/sora_semibold"
			android:fontFeatureSettings="tnum"
			android:includeFontPadding="false"
			android:maxLines="1"
			android:text="@string/expense_widget_zero_whole"
			android:textColor="@color/expense_widget_expense"
			android:textSize="19sp"
			android:textStyle="bold" />

		<TextView
			android:id="@+id/expense_widget_cents"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="1dp"
			android:fontFamily="@font/sora_medium"
			android:fontFeatureSettings="tnum"
			android:includeFontPadding="false"
			android:maxLines="1"
			android:text="@string/expense_widget_zero_cents"
			android:textColor="@color/expense_widget_expense"
			android:textSize="12sp" />

		<TextView
			android:id="@+id/expense_widget_currency"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="2dp"
			android:fontFamily="@font/sora_medium"
			android:includeFontPadding="false"
			android:maxLines="1"
			android:text="@string/expense_widget_currency_symbol"
			android:textColor="@color/expense_widget_expense"
			android:textSize="10sp" />
	</LinearLayout>

	<TextView
		android:id="@+id/expense_widget_status"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:ellipsize="end"
		android:fontFamily="sans-serif"
		android:gravity="center"
		android:includeFontPadding="false"
		android:maxLines="2"
		android:textColor="@color/expense_widget_warning"
		android:textSize="12sp"
		android:textStyle="bold"
		android:visibility="gone" />
</FrameLayout>
